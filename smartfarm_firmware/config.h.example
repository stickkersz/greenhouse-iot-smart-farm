#ifndef CONFIG_H
#define CONFIG_H

// ===== WiFi (WiFiMulti — ต่ออัตโนมัติเครือข่ายที่เจอ) =====
// copy ไฟล์นี้เป็น config.h แล้วใส่ค่าจริงของคุณ
struct WifiCred { const char* ssid; const char* pass; };
static const WifiCred wifiNetworks[] = {
  { "YOUR_WIFI_SSID",     "YOUR_WIFI_PASSWORD"  },
  { "YOUR_WIFI_SSID_2",   "YOUR_WIFI_PASSWORD_2" },
};

// ===== Firebase =====
#define FIREBASE_HOST    "https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app"
#define FIREBASE_API_KEY "YOUR_FIREBASE_API_KEY"

// ===== Pin Mapping =====
#define PIN_DS18B20       4
// SHT35 (อุณหภูมิ+ความชื้นอากาศ) เป็น I2C — ใช้ SDA=GPIO21, SCL=GPIO22 ร่วมกับ LCD ไม่มี PIN_ แยกต่างหาก
#define PIN_BUZZER       33

#define PIN_RELAY_CH1    26   // สำรอง (manual/schedule)
#define PIN_RELAY_CH2    27   // ไม่ได้ใช้
#define PIN_RELAY_CH3    14   // พัดลม 220V AC (ดูดเข้า)
#define PIN_RELAY_CH4    25   // ปั๊มน้ำ 24V DC (ห้ามใช้ GPIO12 — strapping pin ทำให้ boot fail)

// โมดูล Relay active-LOW: LOW=เปิด, HIGH=ปิด (ถ้าโมดูลกลับด้าน เปลี่ยนเป็น false)
#define RELAY_ACTIVE_LOW  true

// โมดูล Buzzer 3 ขา (S/VCC/GND) active-LOW เหมือน relay: LOW=ดัง, HIGH=เงียบ
// (ถ้าเสียบแล้วดังตลอดเวลา = โมดูลจริงเป็น active-HIGH ให้เปลี่ยนเป็น false)
#define BUZZER_ACTIVE_LOW true

// ===== Auto Control Thresholds =====
#define TEMP_ON       35.0
#define TEMP_OFF      32.0
#define HUMIDITY_MIN  60.0

// ===== Timing (milliseconds) =====
#define SENSOR_INTERVAL   30000UL
#define LOG_INTERVAL    3600000UL

#endif
